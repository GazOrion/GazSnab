# connection_limit снижает «зависания» при частых перезапусках dev на Windows
DATABASE_URL="postgresql://postgres:root@localhost:5432/GazSnab?schema=public&connection_limit=5"
# Локально: http://localhost:3000 | на проде: https://orion-gaz.ru
SITE_URL="http://localhost:3000"
ADMIN_PASSWORD="root"
AUTH_SECRET="change-me"

# OrionCRM — заявки с сайта (ключ только на сервере)
ORION_CRM_API_KEY=
ORION_CRM_API_URL=https://gaz-orion.ru/api/public/requests
